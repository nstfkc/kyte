{
  "name": "kyte-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": ["packages/*", "sandbox/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
