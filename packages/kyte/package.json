{
  "name": "kyte",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@kyte/core": "workspace:*",
    "@kyte/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "typescript": "^5.7.0",
    "react": "^19.0.0",
    "@types/react": "^19.0.0"
  }
}
